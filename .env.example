# ============================================================
#  .env.example — Environment Configuration Template
#  Copy this to .env and update values for your environment
# ============================================================

# ── APPLICATION SETTINGS ────────────────────────────────

# Application name
APP_NAME="Rescue 1122 HRM"

# Environment (local, staging, production)
APP_ENV=local

# Enable/Disable debug mode (NEVER true in production!)
APP_DEBUG=true

# Application URL
APP_URL=http://localhost/abc

# ── FRONTEND CONFIGURATION ──────────────────────────────

# API Base URL for frontend
# Local development
FRONTEND_API_BASE=http://127.0.0.1:8000/api

# Photo upload base URL
FRONTEND_PHOTO_BASE=http://127.0.0.1:8000/storage/uploads/

# Frontend URL (where frontend is hosted)
FRONTEND_URL=http://localhost/abc/employee-profile/

# For production, uncomment and update:
# FRONTEND_API_BASE=https://your-domain.com/api
# FRONTEND_PHOTO_BASE=https://your-domain.com/storage/uploads/
# FRONTEND_URL=https://your-domain.com/hrm/

# ── DATABASE CONFIGURATION ──────────────────────────────

# Database driver (mysql, postgresql, sqlite, sqlsrv)
DB_CONNECTION=mysql

# Database host
DB_HOST=127.0.0.1

# Database port
DB_PORT=3306

# Database name
DB_DATABASE=hrm_db

# Database username
DB_USERNAME=root

# Database password (leave empty for XAMPP default)
DB_PASSWORD=

# ── LARAVEL BACKEND SETTINGS ────────────────────────────

# Application key (generate with: php artisan key:generate)
APP_KEY=base64:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# API host and port
API_HOST=127.0.0.1
API_PORT=8000

# ── AUTHENTICATION SETTINGS ─────────────────────────────

# JWT Secret (if using JWT instead of Laravel tokens)
JWT_SECRET=your-secret-key-here

# Token expiration time (in minutes)
TOKEN_EXPIRATION=1440

# Refresh token expiration (in days)
REFRESH_TOKEN_EXPIRATION=30

# ── FILE UPLOAD SETTINGS ────────────────────────────────

# Maximum file size in bytes (5MB = 5242880 bytes)
MAX_FILE_SIZE=5242880

# Allowed file extensions
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,csv

# Upload directory
UPLOAD_DIR=storage/uploads/

# ── SECURITY SETTINGS ───────────────────────────────────

# Force HTTPS in production
FORCE_HTTPS=false

# Secure cookies
SESSION_SECURE_COOKIES=false

# Same-site cookies (Strict, Lax, None)
SESSION_SAME_SITE=Lax

# CORS enabled origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000

# ── MAIL CONFIGURATION (Optional) ───────────────────────

# Mail driver (smtp, sendmail, mailgun, ses, postmark, log)
MAIL_DRIVER=log

# SMTP host
MAIL_HOST=smtp.mailtrap.io

# SMTP port
MAIL_PORT=465

# Mail username
MAIL_USERNAME=

# Mail password
MAIL_PASSWORD=

# Mail from address
MAIL_FROM_ADDRESS=noreply@rescue1122.com

# Mail from name
MAIL_FROM_NAME="${APP_NAME}"

# ── LOGGING CONFIGURATION ──────────────────────────────

# Log channel (single, daily, slack, syslog, errorlog)
LOG_CHANNEL=daily

# Log level (debug, info, notice, warning, error, critical, alert, emergency)
LOG_LEVEL=debug

# ── CACHE CONFIGURATION ────────────────────────────────

# Cache driver (file, database, redis, memcached)
CACHE_DRIVER=file

# ── SESSION CONFIGURATION ──────────────────────────────

# Session driver (file, cookie, database, memcached, redis)
SESSION_DRIVER=file

# ── QUEUE CONFIGURATION (Optional) ──────────────────────

# Queue driver (sync, database, beanstalkd, sqs, redis)
QUEUE_DRIVER=sync

# ── REDIS CONFIGURATION (Optional) ──────────────────────

# Redis host
REDIS_HOST=127.0.0.1

# Redis password
REDIS_PASSWORD=null

# Redis port
REDIS_PORT=6379

# ── DEVELOPMENT SETTINGS ───────────────────────────────

# Enable query logging (for debugging)
DB_LOG_QUERIES=false

# Enable API logging
API_LOG_REQUESTS=false

# ── THIRD-PARTY SERVICES (Optional) ────────────────────

# AWS configuration (if using S3 for storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# Sentry error tracking (optional)
# SENTRY_DSN=

# ============================================================
#  SETUP INSTRUCTIONS
# ============================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate Laravel key:
#    php artisan key:generate
#
# 3. Update database credentials:
#    DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD
#
# 4. For local development, update API URLs:
#    API_HOST=127.0.0.1
#    API_PORT=8000
#    FRONTEND_API_BASE=http://127.0.0.1:8000/api
#
# 5. For production, update:
#    APP_ENV=production
#    APP_DEBUG=false
#    FORCE_HTTPS=true
#    Update all URLs to your domain
#
# 6. Run migrations:
#    php artisan migrate
#
# 7. Seed default data:
#    php artisan db:seed
#
# ============================================================
